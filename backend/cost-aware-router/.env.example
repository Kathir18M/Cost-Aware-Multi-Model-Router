# ============================================================
# LLM PROVIDERS
# ============================================================
MISTRAL_API_KEY=your_mistral_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_MODEL=mistral-small-latest

# ============================================================
# MODEL PRICING ($ per million tokens)
# ============================================================
GEMINI_INPUT_PRICE=0.10
GEMINI_OUTPUT_PRICE=0.40
MISTRAL_INPUT_PRICE=0.20
MISTRAL_OUTPUT_PRICE=0.60

# ============================================================
# ROUTING CONFIGURATION
# ============================================================
CONFIDENCE_THRESHOLD=0.75
COMPLEXITY_THRESHOLD=0.70

# ============================================================
# MONGODB DATABASE CONFIGURATION
# ============================================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=cost_aware_router

# ============================================================
# CLERK AUTHENTICATION
# ============================================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_ISSUER=https://your-clerk-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=https://your-clerk-app.clerk.accounts.dev

# ============================================================
# JWT & SECURITY
# ============================================================
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_REFRESH_SECRET_KEY=your_jwt_refresh_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECURE=false

# ============================================================
# APPLICATION LOGGING
# ============================================================
LOG_LEVEL=INFO
